{
  "name": "@notlm/core",
  "version": "1.0.0",
  "description": "NotLM portable runtime — pack NLU, dispatch, miss/conversation logging, decision fallback",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tycheung/notlm.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tycheung/notlm/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/tycheung/notlm/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loadFolder": {
      "types": "./dist/loadFolder.d.ts",
      "import": "./dist/loadFolder.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b && node ../../scripts/ci/copy_heuristics_json.mjs"
  }
}
