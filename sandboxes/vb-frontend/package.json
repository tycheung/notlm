{
  "name": "react-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:fullflow": "playwright test --grep @fullflow",
    "test:e2e:full-event-sim": "playwright test tests/e2e/full-event-simulation --grep @full-event-sim",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:checklist": "playwright test tests/e2e/checklist --grep @checklist",
    "test:e2e:guide-nlu": "playwright test tests/e2e/director-guide-nlu.spec.ts",
    "check:datetime": "node scripts/check-datetime-naive-utc.mjs",
    "check:god-components": "node scripts/check-god-component-sizes.mjs",
    "check:vibe-ship": "node scripts/check-vibe-ship-invariants.mjs",
    "check:pr-handoff": "node scripts/check-pr-handoff.mjs",
    "lint:api": "eslint src/api",
    "lint:side-actions": "eslint \"src/components/side_actions/**/*.{ts,tsx}\" \"src/features/side-actions/**/*.{ts,tsx}\" src/components/common/Tabs.tsx",
    "preview": "vite preview",
    "perf:build": "vite build",
    "perf:preview": "vite preview --port 4173 --strictPort",
    "perf:lighthouse": "lighthouse http://127.0.0.1:4173/ --only-categories=performance --preset=desktop --output=html --output-path=./lighthouse-report.html --chrome-flags=--headless=new"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@huggingface/transformers": "^3.8.1",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/x-data-grid": "^7.28.3",
    "@mui/x-date-pickers": "^8.2.0",
    "@tanstack/react-query": "^5.69.0",
    "@types/react-datepicker": "^7.0.0",
    "@xyflow/react": "^12.8.1",
    "axios": "^1.8.3",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-datepicker": "^8.3.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/axios": "^0.14.4",
    "@types/dagre": "^0.7.53",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.10",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.15.0",
    "happy-dom": "^20.9.0",
    "lighthouse": "^12.8.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lighthouse": {
      "@sentry/node": "^10.64.0"
    }
  }
}
