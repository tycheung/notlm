{
  "name": "workflow-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Plug-and-play workflow coach: core + react host + pack mapper/codegen",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages apps --max-warnings=0",
    "ci": "node scripts/ci/ci_check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0"
  }
}
