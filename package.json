{
  "name": "notlm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "NotLM — generic SPA chatbot frontline (runtime: core + react + schema + ranker infer)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/ci/copy_heuristics_json.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --project=demo-todo --project=demo-crm --project=demo-hello",
    "test:e2e:todo": "playwright test --project=demo-todo",
    "test:e2e:crm": "playwright test --project=demo-crm",
    "test:e2e:firefox": "playwright test --project=demo-todo-firefox",
    "lint": "eslint packages apps --max-warnings=0",
    "ci": "node scripts/ci/ci_check.mjs",
    "ci:dx": "node scripts/ci/ci_check.mjs --with-dx",
    "check:host-bleed": "node scripts/ci/host_bleed_check.mjs",
    "notlmCLI": "node packages/cli/dist/cli.js",
    "check:demo": "node packages/cli/dist/cli.js intents check packs/demo-todo",
    "changeset": "changeset",
    "publish:dry-run": "node scripts/ci/publish_dry_run.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "vite": "^5.4.21"
  }
}
